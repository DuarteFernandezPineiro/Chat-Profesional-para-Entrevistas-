# Copy this file to .env and replace the API key with your own value.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_RETRIES=2
OPENAI_REASONING_EFFORT=low
OPENAI_GENERATION_ATTEMPTS=2
# Límite independiente para la fase obligatoria de selección de fuentes.
OPENAI_PLANNING_MAX_OUTPUT_TOKENS=2000
PORT=8000
CHAT_COOKIE_SECURE=false
CHAT_ENABLE_HSTS=false
# Analítica opcional de PostHog. La clave de proyecto es pública y se entrega al navegador.
# POSTHOG_PUBLIC_KEY=phc_tu_clave_publica
# POSTHOG_HOST=https://eu.i.posthog.com
# En producción, establece estas variables en tu plataforma de despliegue:
# CHAT_COOKIE_SECURE=true
# CHAT_ENABLE_HSTS=true
# CHAT_PUBLIC_ORIGIN=https://tu-dominio.example
# CHAT_ALLOWED_HOSTS=tu-dominio.example,tu-app.ondigitalocean.app
